# Optional settings. No AI keys or message broker are needed.
HOST=127.0.0.1
PORT=3000
# npm start stores data here; relative to the project directory.
DATA_DIR=.internship-data
# Only used by dev:api and migrate (Docker supplies its own connection).
# Legacy local database names are retained to preserve existing data on upgrade.
DATABASE_URL=postgres://triageflow:triageflow_dev@localhost:5432/triageflow
