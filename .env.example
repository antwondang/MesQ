# Defaults run without any API key. Do not commit your .env file.
AI_PROVIDER=mock
GEMINI_API_KEY=
# In Gemini mode, set a model available to your account with structured output.
GEMINI_MODEL=
MOCK_DELAY_MS=700
AI_TIMEOUT_MS=30000
LEASE_MS=45000
MAX_ATTEMPTS=3
MAX_CRASH_RECOVERIES=3
RETRY_BASE_MS=2000
PORT=3000
DATABASE_URL=postgres://triageflow:triageflow_dev@localhost:5432/triageflow
RABBITMQ_URL=amqp://triageflow:triageflow_dev@localhost:5672
QUEUE_PREFIX=triageflow
