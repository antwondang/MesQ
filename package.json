{
  "name": "studyflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "node --watch --import tsx apps/api/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "worker": "node --import tsx apps/worker/index.ts",
    "relay": "node --import tsx apps/worker/relay.ts",
    "migrate": "node --import tsx scripts/migrate.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node --import tsx scripts/integration.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "dev": "node --import tsx scripts/demo.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "amqplib": "0.10.9",
    "express": "5.3.0",
    "lucide-react": "1.67.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "10.0.1",
    "@types/amqplib": "0.10.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
